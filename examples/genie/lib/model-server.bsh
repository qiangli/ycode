# genie_model_server: reach the host's model door (bashy's one model server,
# port 24556, shared by every shell and agent) instead of starting a server of
# our own. The door is started if it is not running; $model is pulled once
# under a lock; a sticky binding pins the model's digest and the context
# length for this run, and OPENAI_BASE_URL / OPENAI_API_KEY are exported with
# the binding in the base URL. An EXIT trap deletes the binding. Sourced by
# the solve and chat targets (dag.md); expects $model, $context and $run_id.
genie_model_server() {
  genie_lock=
  genie_sticky=
  trap 'if [ -n "$genie_sticky" ]; then "$BASHY" llm sticky rm "$genie_sticky" > /dev/null 2>&1 || true; fi; if [ -n "$genie_lock" ]; then rmdir "$genie_lock" 2>/dev/null || true; fi' EXIT
  if ! "$BASHY" llm up > /dev/null; then
    printf 'genie: the model door did not start; see %s\n' "${BASHY_HOME:-$HOME/.bashy}/broker/door.log" >&2
    return 1
  fi
  eval "$("$BASHY" llm env)"

  # One download per model across concurrent runs: a lock directory in the
  # shared store's parent.
  genie_lock=${BASHY_HOME:-$HOME/.bashy}/genie/locks/$(printf '%s' "$model" | tr ':/' '__').pull
  mkdir -p "$(dirname "$genie_lock")"
  until mkdir "$genie_lock" 2>/dev/null; do sleep 2; done
  if ! "$BASHY" ollama show "$model" > /dev/null 2>&1; then
    printf 'genie: pulling %s (first use on this host)\n' "$model" >&2
    "$BASHY" ollama pull "$model"
  fi
  rmdir "$genie_lock"
  genie_lock=

  # The binding freezes the model digest and the context length: every call
  # of this run is served by exactly that, or refused.
  genie_sticky=$(printf '%s' "$run_id" | tr -c 'A-Za-z0-9_.-' '-')
  if ! "$BASHY" llm sticky create "$genie_sticky" --model "$model" --num-ctx "$context" --ttl 24h > /dev/null; then
    printf 'genie: could not bind %s on the model door\n' "$model" >&2
    genie_sticky=
    return 1
  fi
  eval "$("$BASHY" llm env --sticky "$genie_sticky")"
  export OPENAI_BASE_URL OPENAI_API_KEY OLLAMA_HOST
  # The door's own client checks the model answers: a host with only bashy
  # has no curl.
  if ! "$BASHY" ollama run --think=false --hidethinking "$model" "Reply with OK." < /dev/null > /dev/null 2>&1; then
    printf 'genie: %s did not answer through the model door\n' "$model" >&2
    return 1
  fi
  printf 'genie: model %s on the model door (sticky %s)\n' "$model" "$genie_sticky" >&2
}
