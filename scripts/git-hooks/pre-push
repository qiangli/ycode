#!/usr/bin/env bash
# pre-push: three gates, cheapest first —
#   1. gofmt          (~0.2s)  reports unformatted files; NEVER rewrites
#   2. .sibling-pins  (~0.0s)  refuses a push while a pin disagrees with its
#                              sibling HEAD, because CI clones the PINNED SHA
#   3. `make ci`      (minutes) the full GitHub Actions matrix in Docker
#
# The order is the point: a stale pin or a stray tab should not cost a full
# Docker matrix run to discover.
#
# Why the pin gate matters more than it looks: .sibling-pins is the only sibling
# source CI ever sees, and inside the dhnt umbrella the siblings are submodules
# — so the pins are never consulted locally and a stale pin CANNOT fail a local
# build. It builds the live sibling and passes while CI builds the pinned one
# and dies on code that plainly exists. A sibling repo in this family sat 26
# commits behind the commit introducing a package it imports; every CI run
# failed to compile, every local build was green, and nothing said so.
#
# Installed by `make install-hooks` (symlinks this file into .git/hooks/).
# Bypass for a one-off: `git push --no-verify`.
#
# Skipped automatically when:
#   - the only thing being pushed is a tag (release flow)
#   - YCODE_SKIP_CI_HOOK=1 is set
set -euo pipefail

# Read refs being pushed from stdin (git invokes the hook with these on
# stdin). If only tag refs are pushed, skip — release.yml handles them.
only_tags=true
any=false
while read -r local_ref local_sha remote_ref remote_sha; do
  any=true
  case "$remote_ref" in
    refs/tags/*) ;;
    *) only_tags=false ;;
  esac
done

if ! $any; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

./scripts/fmtcheck.sh

# Git EXPORTS GIT_DIR when it invokes a hook. In a submodule checkout that is an
# absolute path to THIS repo's gitdir, so a bare `git -C ../sibling rev-parse
# HEAD` resolves ycode's own HEAD — every sibling reports the same SHA and the
# gate compares the wrong thing. It only shows up in a real umbrella clone (a
# plain .git DIRECTORY gets no GIT_DIR and works by accident), and ycode IS a
# gitlink there, so this is not theoretical.
sibling_head() {
  (unset GIT_DIR GIT_WORK_TREE && git -C "$1" rev-parse HEAD 2>/dev/null)
}

pins=.sibling-pins
if [ -f "$pins" ]; then
  drift=''
  while IFS= read -r line; do
    case "$line" in '' | '#'*) continue ;; esac
    name=${line%%=*}
    pinned=$(printf %s "${line#*=}" | tr -d '[:space:]')
    [ -n "$name" ] && [ -n "$pinned" ] && [ "$name" != "$pinned" ] || continue

    dir=../$name
    # A standalone clone has no siblings to compare against — nothing to police.
    [ -e "$dir/.git" ] || continue
    actual=$(sibling_head "$dir") || continue
    [ -n "$actual" ] || continue
    [ "$pinned" = "$actual" ] && continue

    if [ -z "$drift" ]; then
      echo "pre-push: .sibling-pins is stale — CI would build the wrong sibling." >&2
      echo >&2
      drift=yes
    fi
    printf '  %-12s pinned %s\n' "$name" "$(printf %s "$pinned" | cut -c1-12)" >&2
    printf '  %-12s actual %s  (%s HEAD)\n' '' "$(printf %s "$actual" | cut -c1-12)" "$dir" >&2
    echo >&2
  done <"$pins"

  if [ -n "$drift" ]; then
    cat >&2 <<'PINEOF'
Fix (resync the pins to the sibling HEADs, then commit them with your change):

  ./scripts/update-sibling-pins.sh
  git commit -am 'chore: bump .sibling-pins'

The sibling commit must also be pushed to its own origin — CI clones the pin
from GitHub, so a SHA that exists only on this machine fails there too.

Bump the pins LAST, after every sibling commit is final: the check is strict
equality with the sibling's HEAD, so one more sibling commit re-stales it.

Bypass (you are certain CI has the sibling it needs): git push --no-verify
PINEOF
    exit 1
  fi
fi

# The escape hatch now skips ONLY the minutes-long matrix. The two gates above
# cost ~0.2s and catch things `make ci` would not even look at (a stale pin is
# invisible to a local build), so bypassing them saves nothing and hides the
# failures that are hardest to diagnose later. `git push --no-verify` is still
# the total bypass.
if $only_tags; then
  echo "pre-push: tag-only push, skipping make ci (fast gates still ran)" >&2
  exit 0
fi
if [ "${YCODE_SKIP_CI_HOOK:-0}" = "1" ]; then
  echo "pre-push: YCODE_SKIP_CI_HOOK=1, skipping make ci (fast gates still ran)" >&2
  exit 0
fi

echo "pre-push: running 'make ci' (set YCODE_SKIP_CI_HOOK=1 to bypass)..." >&2
make ci
